# Copy each KEY=VALUE pair into a separate Render environment variable.
# Do not commit live credentials or paste the entire file into one Render field.

NODE_ENV=production
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?connect_timeout=30&pool_timeout=30
NEXTAUTH_URL=https://YOUR-RENDER-SERVICE.onrender.com
NEXTAUTH_SECRET=GENERATE_A_NEW_LONG_RANDOM_SECRET

# Optional dashboard data
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Optional email delivery
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=UnifyOS <onboarding@resend.dev>
SUPPORT_EMAIL=YOUR_SUPPORT_EMAIL
REQUIRE_EMAIL_VERIFICATION=false

# Required for any OAuth integration token storage
ENCRYPTION_KEY=64_HEX_CHARACTERS_GENERATED_WITH_OPENSSL_RAND_HEX_32

# Slack OAuth and Events API
SLACK_CLIENT_ID=YOUR_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=YOUR_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=YOUR_SLACK_SIGNING_SECRET
# Slack Events Request URL: https://YOUR-RENDER-SERVICE.onrender.com/api/integrations/slack/events

# Notion public OAuth connection
NOTION_CLIENT_ID=YOUR_NOTION_CLIENT_ID
NOTION_CLIENT_SECRET=YOUR_NOTION_CLIENT_SECRET
NOTION_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/api/apps/notion/callback

# Optional recommended OAuth providers
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
ASANA_CLIENT_ID=YOUR_ASANA_CLIENT_ID
ASANA_CLIENT_SECRET=YOUR_ASANA_CLIENT_SECRET
MONDAY_CLIENT_ID=YOUR_MONDAY_CLIENT_ID
MONDAY_CLIENT_SECRET=YOUR_MONDAY_CLIENT_SECRET
HUBSPOT_CLIENT_ID=YOUR_HUBSPOT_CLIENT_ID
HUBSPOT_CLIENT_SECRET=YOUR_HUBSPOT_CLIENT_SECRET
SALESFORCE_CLIENT_ID=YOUR_SALESFORCE_CLIENT_ID
SALESFORCE_CLIENT_SECRET=YOUR_SALESFORCE_CLIENT_SECRET
TRELLO_API_KEY=YOUR_TRELLO_API_KEY
TRELLO_API_SECRET=YOUR_TRELLO_API_SECRET
