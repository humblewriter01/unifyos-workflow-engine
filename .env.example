# UnifyOS production and local environment
# Core settings are required for authentication. Provider and dashboard integrations are optional.

# Core authentication database (PostgreSQL)
# On Render, use Supabase Connect → Session pooler (aws-*.pooler.supabase.com:5432),
# not db.<project-ref>.supabase.co:5432 unless your project/network supports IPv6.
DATABASE_URL="postgresql://username:password@localhost:5432/unifyos?connect_timeout=30&pool_timeout=30"

# Public origin of the app. Used for NextAuth callbacks and integration OAuth
# redirect URIs, and it must match the provider consoles exactly.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app   (no trailing slash)
# APP_URL wins over NEXTAUTH_URL. On Vercel, leave both unset for preview
# deployments so the deployment URL is detected automatically.
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NODE_ENV=development

# Optional dashboard data service. Without these values, read-only dashboard endpoints
# return safe empty states and the application still starts.
# Use the bare project origin — no trailing slash and no /rest/v1 suffix.
# NEXT_PUBLIC_SUPABASE_URL="https://gsuipjnxshrqelmicvyo.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional email service. Enables email verification, password reset,
# and support-email delivery when configured.
# RESEND_API_KEY="re_your_resend_api_key_here"
# EMAIL_FROM="UnifyOS <onboarding@resend.dev>"
# SUPPORT_EMAIL="support@example.com"
# Set true only when RESEND_API_KEY is configured; false keeps credentials login available without email delivery.
# REQUIRE_EMAIL_VERIFICATION=false
# ADMIN_EMAIL="admin@example.com"

# Optional OAuth / application integrations. Add a provider’s complete set later.
# Google (Docs, Drive, Sheets, Slides, Gmail, Calendar, Forms, Tasks, Contacts
# and "Continue with Google" sign-in)
# GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
#
# Redirect URIs to register per environment (see GOOGLE_INTEGRATIONS.md):
#   <APP_URL>/api/auth/callback/google      sign-in
#   <APP_URL>/api/apps/google/callback      unified Workspace connection
#   <APP_URL>/api/apps/gmail/callback       legacy per-app Gmail connection
#   <APP_URL>/api/apps/calendar/callback    legacy per-app Calendar connection
#
# Google sign-in requests the full Workspace scope set by default. Set this to
# true to request only `openid email profile` at sign-in and grant Workspace
# access exclusively through Settings -> Integrations.
# GOOGLE_SIGNIN_PROFILE_SCOPES_ONLY=false
#
# Off by default: when true, a Google identity is linked to an existing
# password account with the same Google-verified email address. Leaving it off
# returns OAuthAccountNotLinked instead of silently merging accounts.
# AUTH_ALLOW_GOOGLE_EMAIL_LINKING=false

# Slack
# SLACK_CLIENT_ID="your-slack-client-id"
# SLACK_CLIENT_SECRET="your-slack-client-secret"
# SLACK_SIGNING_SECRET="your-slack-signing-secret"  # required only for Slack Events API
# Slack Events Request URL: https://your-app.onrender.com/api/integrations/slack/events

# Notion
# NOTION_CLIENT_ID="your-notion-client-id"
# NOTION_CLIENT_SECRET="your-notion-client-secret"
# NOTION_REDIRECT_URI="https://your-app.onrender.com/api/apps/notion/callback"
# The redirect URI must exactly match the URI registered in the Notion developer portal.

# Trello
# TRELLO_API_KEY="your-trello-api-key"
# TRELLO_API_SECRET="your-trello-api-secret"

# Asana
# ASANA_CLIENT_ID="your-asana-client-id"
# ASANA_CLIENT_SECRET="your-asana-client-secret"

# Monday.com
# MONDAY_CLIENT_ID="your-monday-client-id"
# MONDAY_CLIENT_SECRET="your-monday-client-secret"

# Optional future CRM providers
# HUBSPOT_CLIENT_ID="your-hubspot-client-id"
# HUBSPOT_CLIENT_SECRET="your-hubspot-client-secret"
# SALESFORCE_CLIENT_ID="your-salesforce-client-id"
# SALESFORCE_CLIENT_SECRET="your-salesforce-client-secret"

# Required when enabling any integration that stores OAuth tokens.
# Use exactly 64 hexadecimal characters (32 bytes).
# ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"
