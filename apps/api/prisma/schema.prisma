generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  name                 String?
  passwordHash         String?   @db.Text
  plan                 UserPlan  @default(FREE)
  adminRole            AdminRole @default(NONE)
  emailVerified        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  lastLoginAt          DateTime?
  twoFactorEnabled     Boolean   @default(false)
  twoFactorSecret      String?   @db.Text
  twoFactorRecoveryCodes Json?

  accounts      Account[]
  sessions      Session[]
  workflows     Workflow[]
  notifications Notification[]
  appTokens       AppToken[]
  billingCustomer BillingCustomer?
  subscriptions   Subscription[]
  payments        Payment[]

  @@index([email])
  @@map("User")
}

enum UserPlan {
  FREE
  PRO
  BUSINESS
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String? @map("refresh_token") @db.Text
  accessToken       String? @map("access_token") @db.Text
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("Account")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("Session")
}

model AppToken {
  id           String    @id @default(uuid())
  userId       String
  appName      String
  accessToken  String    @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  scope        String?
  metadata     Json?
  connected    Boolean   @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, appName])
  @@index([userId])
  @@index([appName])
  @@map("AppToken")
}

model Workflow {
  id             String   @id @default(uuid())
  userId         String
  name           String
  description    String?
  triggerApp     String
  triggerEvent   String
  triggerConfig  Json
  actions        Json
  enabled        Boolean  @default(true)
  executionCount Int      @default(0)
  lastExecutedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([userId])
  @@index([enabled])
  @@map("Workflow")
}

model WorkflowExecution {
  id           String          @id @default(uuid())
  workflowId   String
  status       ExecutionStatus
  triggerData  Json
  results      Json?
  error        String?         @db.Text
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  duration     Int?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([status])
  @@index([startedAt])
  @@map("WorkflowExecution")
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

model Notification {
  id         String               @id @default(uuid())
  userId     String
  appName    String
  appIcon    String?
  title      String
  message    String               @db.Text
  priority   NotificationPriority @default(MEDIUM)
  read       Boolean              @default(false)
  metadata   Json?
  externalId String?
  createdAt  DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("Notification")
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

enum AdminRole {
  NONE
  SUPPORT_READONLY
  BILLING_ADMIN
  CATALOG_ADMIN
  SUPER_ADMIN
}

enum PlanStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
  ONE_TIME
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  CANCELLED
  REFUNDED
  DISPUTED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

model BillingPlan {
  id          String     @id @default(uuid())
  key         String     @unique
  name        String
  description String?
  status      PlanStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  prices      BillingPrice[]
  entitlements PlanEntitlement[]
  subscriptions Subscription[]
  @@index([status, updatedAt])
  @@map("BillingPlan")
}

model BillingPrice {
  id          String         @id @default(uuid())
  planId      String
  version     Int
  amount      Int
  currency    String
  interval    BillingInterval
  trialDays   Int            @default(0)
  effectiveAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  plan        BillingPlan    @relation(fields: [planId], references: [id], onDelete: Restrict)
  @@unique([planId, version])
  @@index([currency, interval, effectiveAt])
  @@map("BillingPrice")
}

model FeatureDefinition {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  entitlements PlanEntitlement[]
  @@map("FeatureDefinition")
}

model PlanEntitlement {
  id        String           @id @default(uuid())
  planId    String
  featureId String
  limit     Int?
  metadata  Json?
  plan      BillingPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   FeatureDefinition @relation(fields: [featureId], references: [id], onDelete: Restrict)
  @@unique([planId, featureId])
  @@map("PlanEntitlement")
}

model BillingCustomer {
  id                    String   @id @default(uuid())
  userId                String   @unique
  providerCustomerCode  String?
  email                 String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([providerCustomerCode])
  @@map("BillingCustomer")
}

model Subscription {
  id                       String             @id @default(uuid())
  userId                   String
  planId                   String
  provider                 String
  providerSubscriptionCode String?
  status                   SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  canceledAt               DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  user                     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan                     BillingPlan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments                 Payment[]
  @@unique([provider, providerSubscriptionCode])
  @@index([userId, status, currentPeriodEnd])
  @@map("Subscription")
}

model Payment {
  id                    String        @id @default(uuid())
  userId                String
  subscriptionId        String?
  provider              String
  reference             String        @unique
  providerTransactionId String?
  amount                Int
  currency              String
  status                PaymentStatus @default(PENDING)
  metadata              Json?
  verifiedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  user                  User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  @@unique([provider, providerTransactionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("Payment")
}

model ProviderEvent {
  id          String             @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  payload     Json
  status      ProviderEventStatus @default(RECEIVED)
  processedAt DateTime?
  error       String?            @db.Text
  createdAt   DateTime           @default(now())
  @@unique([provider, eventId])
  @@index([provider, eventType, createdAt])
  @@map("ProviderEvent")
}

model UsageMetric {
  id         String   @id @default(uuid())
  userId     String
  metricType String
  value      Float
  date       DateTime @default(now())

  @@index([userId, metricType, date])
  @@map("UsageMetric")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  resource  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action])
  @@map("AuditLog")
}
