# UnifyOS frontend environment
# Core authentication settings are required; all integrations are optional.

# On Render, use Supabase Connect → Session pooler (aws-*.pooler.supabase.com:5432).
# The direct db.<project-ref>.supabase.co:5432 endpoint may be IPv6-only.
DATABASE_URL="postgresql://username:password@localhost:5432/unifyos?connect_timeout=30&pool_timeout=30"

# Public origin of the app (no trailing slash). Must match the Google Cloud
# Console "Authorized redirect URIs" entries. APP_URL wins over NEXTAUTH_URL.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NODE_ENV=development

# Optional dashboard data service. Bare project origin: no trailing slash,
# no /rest/v1 suffix.
# NEXT_PUBLIC_SUPABASE_URL="https://gsuipjnxshrqelmicvyo.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional email service
# RESEND_API_KEY="re_your_resend_api_key_here"  # canonical name; RESENDER_API_KEY is accepted temporarily
# EMAIL_FROM="UnifyOS <onboarding@resend.dev>"
# SUPPORT_EMAIL="support@example.com"
# REQUIRE_EMAIL_VERIFICATION=false
# ADMIN_EMAIL="admin@example.com"

# Optional providers
# Google sign-in callback: <APP_URL>/api/auth/callback/google
# Integration callbacks:   <APP_URL>/api/apps/gmail/callback, <APP_URL>/api/apps/calendar/callback
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
# AUTH_ALLOW_GOOGLE_EMAIL_LINKING=false
# SLACK_CLIENT_ID="your-slack-client-id"
# SLACK_CLIENT_SECRET="your-slack-client-secret"
# SLACK_SIGNING_SECRET="your-slack-signing-secret"
# Slack Events Request URL: https://your-app.onrender.com/api/integrations/slack/events
# NOTION_CLIENT_ID="your-notion-client-id"
# NOTION_CLIENT_SECRET="your-notion-client-secret"
# NOTION_REDIRECT_URI="https://your-app.onrender.com/api/apps/notion/callback"
# TRELLO_API_KEY="your-trello-api-key"
# TRELLO_API_SECRET="your-trello-api-secret"
# ASANA_CLIENT_ID="your-asana-client-id"
# ASANA_CLIENT_SECRET="your-asana-client-secret"
# MONDAY_CLIENT_ID="your-monday-client-id"
# MONDAY_CLIENT_SECRET="your-monday-client-secret"
# HUBSPOT_CLIENT_ID="your-hubspot-client-id"
# HUBSPOT_CLIENT_SECRET="your-hubspot-client-secret"
# SALESFORCE_CLIENT_ID="your-salesforce-client-id"
# SALESFORCE_CLIENT_SECRET="your-salesforce-client-secret"
# ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"  # 64 hex chars / 32 bytes

# Billing is disabled unless explicitly enabled after Paystack test-mode configuration
BILLING_ENABLED="false"
PAYSTACK_SECRET_KEY=""

# Administrator access is assigned server-side in the database after MFA enrollment.
# Never expose payment or admin secrets through NEXT_PUBLIC_* variables.
